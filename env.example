DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=koperasi
DB_USER=koperasi
DB_PASSWORD=ganti_dengan_password_database


# ==========================================
# APPLICATION
# ==========================================

APP_NAME="Katalog Kopsis Moklet Malang"
APP_URL=http://localhost:3000
PORT=3000


# ==========================================
# LAB MODE
# ==========================================
# true  = mengaktifkan vulnerability untuk praktikum
# false = mode lebih aman
#
# LAB_MODE=true
#   - SQL Injection dasar
#   - Pemindaian dependensi npm audit/Snyk tidak bergantung pada LAB_MODE
#   - Halaman publik menampilkan deskripsi dan pencarian sebagai teks

LAB_MODE=false
